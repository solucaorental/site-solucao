---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<div class="quick-actions">
  <a class="quick-call" href={`tel:+${site.whatsapp}`}><Icon name="phone" />Ligar</a>
  <a class="quick-whatsapp" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer" aria-label="Falar no WhatsApp">
    <Icon name="whatsapp" /><span>WhatsApp</span>
  </a>
  <a class="quick-quote" href="/contato">Orçamento</a>
</div>
