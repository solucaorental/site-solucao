---
interface Props {
  title: string;
  text: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { title, text, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
const external = secondaryHref?.startsWith('http');
---

<section class="cta">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn btn-action" href={primaryHref}>{primaryLabel}</a>
      {secondaryHref && secondaryLabel && (
        <a class="btn btn-inverse" href={secondaryHref} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>
