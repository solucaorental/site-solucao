---
import Icon from './Icon.astro';
import { navItems, site } from '../data/site';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, página inicial`}>
      <img src="/images/logo.png" alt="" width="720" height="246" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
      <span class="nav-toggle-open"><Icon name="menu" /></span>
      <span class="nav-toggle-close" hidden><Icon name="close" /></span>
      Menu
    </button>

    <nav id="main-nav" class="nav-menu" aria-label="Menu principal">
      {navItems.map((item) => (
        <a class="nav-link" aria-current={pathname === item.href ? 'page' : undefined} href={item.href}>{item.label}</a>
      ))}
      <div class="menu-extra">
        <a class="btn btn-action" href="/contato">Solicitar orçamento</a>
        <a class="btn btn-outline" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer"><Icon name="whatsapp" />Falar no WhatsApp</a>
        <a class="btn btn-outline" href={`tel:+${site.whatsapp}`}><Icon name="phone" />Ligar para {site.phone}</a>
        <p>{site.address}</p>
      </div>
    </nav>

    <a class="header-phone" href={`tel:+${site.whatsapp}`}><Icon name="phone" />{site.phone}</a>
    <a class="btn btn-action header-cta" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">
      <Icon name="whatsapp" />
      Orçamento
    </a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.querySelector<HTMLElement>('.nav-menu');
  const openIcon = document.querySelector<HTMLElement>('.nav-toggle-open');
  const closeIcon = document.querySelector<HTMLElement>('.nav-toggle-close');

  const syncMenu = (expanded: boolean) => {
    if (!toggle || !menu || !openIcon || !closeIcon) return;
    toggle.setAttribute('aria-expanded', String(expanded));
    menu.classList.toggle('is-open', expanded);
    document.documentElement.classList.toggle('menu-open', expanded);
    openIcon.hidden = expanded;
    closeIcon.hidden = !expanded;
  };

  syncMenu(false);

  toggle?.addEventListener('click', () => syncMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => syncMenu(false)));
  window.matchMedia('(min-width: 1001px)').addEventListener('change', () => syncMenu(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      syncMenu(false);
      toggle.focus();
    }
  });
</script>
