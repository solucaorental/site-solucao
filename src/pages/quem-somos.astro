---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { companyHighlights, site } from '../data/site';
---

<BaseLayout
  title="Quem Somos | Solução Rental"
  description="Dados institucionais da Solução Rental com base no cadastro da empresa."
  pathname="/quem-somos"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-panel">
        <span class="eyebrow">Quem somos</span>
        <h1>Empresa ativa em Fortaleza com foco em locação para construção</h1>
        <p>A SOLUCAO RENTAL LTDA - ME foi fundada em 05/12/2012 e atua com locação de máquinas e equipamentos para construção sem operador.</p>
      </div>
      <div class="hero-highlight">
        <h3>Dados principais</h3>
        <p>CNPJ {site.cnpj}, natureza jurídica de sociedade empresária limitada, matriz localizada em Fortaleza/CE e situação cadastral ativa.</p>
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container split-section">
      <div class="highlight-surface">
        <SectionHeading
          eyebrow="A Solução Rental"
          title="Atuação principal e atividades complementares"
          text="O foco central da empresa está na locação de equipamentos para construção, somado a serviços complementares ligados a manutenção, obras civis e infraestrutura."
        />
        <p>Entre as atividades secundárias informadas estão manutenção e reparação de equipamentos, construção de edifícios, obras de urbanização, montagem de estruturas metálicas e serviços relacionados a redes de água e esgoto.</p>
      </div>

      <div class="stats-grid">
        {companyHighlights.map((item) => (
          <div class="stat-card">
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Quer falar com a Solução Rental?"
    text="Use o WhatsApp para pedir informações, confirmar atendimento e iniciar um orçamento."
    primaryHref="/contato"
    primaryLabel="Entrar em contato"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="Falar no WhatsApp"
  />
</BaseLayout>
