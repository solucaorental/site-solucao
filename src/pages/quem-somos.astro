---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import CTASection from '../components/CTASection.astro';
import { companyHighlights, site } from '../data/site';

const facts = [
  ['Razão social', site.legalName],
  ['CNPJ', site.cnpj],
  ['Fundação', site.foundationDate],
  ['Natureza jurídica', site.legalNature],
  ['Situação', `${site.status}, ${site.branchType.toLowerCase()}`],
  ['Endereço', site.address]
];
---

<BaseLayout
  title="Quem Somos | Solução Rental"
  description="História, atuação e dados institucionais da Solução Rental, empresa de locação de equipamentos em Fortaleza."
  pathname="/quem-somos"
>
  <PageHead title="Quem somos" text="Locação de máquinas e equipamentos para construção civil e fornecimento de telas fachadeiras, com sede no bairro Mondubim, em Fortaleza.">
    <dl class="highlights">
      {companyHighlights.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
    </dl>
  </PageHead>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2>Foco em locação e telas fachadeiras</h2>
        <p>A atividade principal da Solução Rental é o aluguel de máquinas e equipamentos para construção sem operador, com atuação complementar em serviços de apoio a obras.</p>
        <p>A empresa atende construtoras, prestadores de serviços e profissionais liberais em Fortaleza e região metropolitana, oferecendo comunicação direta e atendimento voltado para a realidade de cada obra.</p>
      </div>
      <div>
        <h2>Dados institucionais</h2>
        <dl class="facts">{facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
      </div>
    </div>
  </section>

  <CTASection
    title="Quer conversar com a Solução Rental?"
    text="Use nosso WhatsApp para pedir mais informações, confirmar disponibilidade ou iniciar um orçamento."
    primaryHref="/contato"
    primaryLabel="Entrar em contato"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="Falar no WhatsApp"
  />
</BaseLayout>
