---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { companyHighlights, site } from '../data/site';
---

<BaseLayout
  title="Quem Somos | Solução Rental"
  description="Tradição, segurança e compromisso com a sua obra."
  pathname="/quem-somos"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-panel">
        <span class="eyebrow">Quem somos</span>
        <h1>Tradição, segurança e compromisso com a sua obra</h1>
        <p>A Solução Rental atua há mais de 30 anos no mercado da construção civil com soluções completas em locação de equipamentos e sistemas de segurança.</p>
      </div>
      <div class="hero-highlight">
        <h3>Presença sólida no mercado</h3>
        <p>Atendemos grandes construtoras e obras de todos os portes em Fortaleza e região metropolitana, com foco em pontualidade e normas técnicas.</p>
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container split-section">
      <div class="highlight-surface">
        <SectionHeading
          eyebrow="A Solução Rental"
          title="Uma operação feita para obra vertical"
          text="Nossa missão é garantir eficiência e segurança nos canteiros de obra, com equipamentos de qualidade e serviços especializados de instalação."
        />
        <p>O novo visual valoriza a história da empresa sem parecer datado, trazendo uma comunicação mais séria, clara e comercial.</p>
      </div>

      <div class="stats-grid">
        {companyHighlights.map((item) => (
          <div class="stat-card">
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Quer falar com uma empresa experiente no setor?"
    text="Estamos prontos para apoiar sua obra com locação, telas e soluções de segurança coletiva."
    primaryHref="/contato"
    primaryLabel="Entrar em contato"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="Falar no WhatsApp"
  />
</BaseLayout>
