---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import CTASection from '../components/CTASection.astro';
import { blogPosts, site } from '../data/site';
---

<BaseLayout
  title="Blog | Solução Rental"
  description="Conteúdo sobre construção civil, locação de equipamentos e organização de obra."
  pathname="/blog"
>
  <PageHead title="Conteúdo útil para sua obra" text="Temas práticos sobre locação de equipamentos, organização de canteiro e produtividade na construção civil." />

  <section class="section">
    <div class="container">
      <h2 class="sr-only">Artigos</h2>
      {blogPosts.length > 0 ? (
        <div class="rows">
          {blogPosts.map((post) => (
            <article class="row row--post">
              <p class="row-meta">{post.date}</p>
              <div><h3>{post.title}</h3><p>{post.excerpt}</p></div>
              <a class="text-link" href="/contato">Falar com a equipe<span class="sr-only"> sobre: {post.title}</span></a>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty">
          <h3>Nenhum artigo publicado</h3>
          <p>Para dúvidas sobre equipamentos ou telas, fale com a equipe.</p>
          <a class="btn btn-outline" href="/contato">Falar com a equipe</a>
        </div>
      )}
    </div>
  </section>

  <CTASection
    title="Quer falar diretamente com a equipe?"
    text="Use o WhatsApp para pedir um orçamento ou tirar dúvidas sobre equipamentos e telas fachadeiras."
    primaryHref="/contato"
    primaryLabel="Entrar em contato"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="Falar no WhatsApp"
  />
</BaseLayout>
