---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BlogCard from '../components/BlogCard.astro';
import CTASection from '../components/CTASection.astro';
import { blogPosts, site } from '../data/site';
---

<BaseLayout
  title="Conteúdo | Solução Rental"
  description="Conteúdo institucional e informativo sobre locação e operação na construção."
  pathname="/blog"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-panel">
        <span class="eyebrow">Conteúdo</span>
        <h1>Informações úteis sobre locação e operação na construção</h1>
        <p>Esta área foi adaptada para apoiar a apresentação institucional da empresa com temas próximos da sua atuação.</p>
      </div>
      <div class="highlight-surface">
        <h3>Base pronta para evolução</h3>
        <p>Os textos atuais funcionam como apoio comercial e podem crescer depois para uma área editorial mais completa.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Conteúdo"
        title="Leituras em destaque"
        text="Assuntos que ajudam clientes e parceiros a tomar decisões melhores sobre locação e operação de obra."
      />
      <div class="blog-grid">
        {blogPosts.map((post) => <BlogCard {...post} />)}
      </div>
    </div>
  </section>

  <CTASection
    title="Quer atendimento direto em vez de continuar pesquisando?"
    text="A empresa pode orientar rapidamente qual atendimento inicial faz mais sentido para sua demanda."
    primaryHref="/contato"
    primaryLabel="Pedir atendimento"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="WhatsApp"
  />
</BaseLayout>
