---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Catalog from '../components/Catalog.astro';
import Steps from '../components/Steps.astro';
import CTASection from '../components/CTASection.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Locação de Equipamentos | Solução Rental"
  description="Locação de máquinas e equipamentos para construção civil em Fortaleza e região."
  pathname="/locacao"
>
  <PageHead title="Locação de equipamentos" text="Monte a lista do que sua obra precisa, com quantidade e prazo, e envie o pedido pronto para a equipe." image="/images/andaime.webp" imageAlt="Andaime tubular montado em obra" />

  <section class="section section--catalog" aria-label="Catálogo de equipamentos">
    <div class="container"><Catalog /></div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2>Como funciona a locação</h2>
      <Steps />
    </div>
  </section>

  <CTASection
    title="Não encontrou o equipamento?"
    text="Descreva o serviço que vai executar. A equipe consulta a disponibilidade e orienta a escolha."
    primaryHref="/contato"
    primaryLabel="Solicitar orçamento"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="Falar no WhatsApp"
  />
</BaseLayout>
