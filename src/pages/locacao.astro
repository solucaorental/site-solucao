---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EquipmentCard from '../components/EquipmentCard.astro';
import CTASection from '../components/CTASection.astro';
import { equipment, site } from '../data/site';
---

<BaseLayout
  title="Locação de Equipamentos | Solução Rental"
  description="Locação de máquinas e equipamentos para construção em Fortaleza e região."
  pathname="/locacao"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-panel">
        <span class="eyebrow">Locação de equipamentos</span>
        <h1>Locação para obras e operações de construção</h1>
        <p>A atividade principal da empresa é o aluguel de máquinas e equipamentos para construção sem operador.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contato">Pedir orçamento</a>
          <a class="btn btn-secondary" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">Falar com a equipe</a>
        </div>
      </div>
      <div class="highlight-surface">
        <h3>Catálogo de equipamentos</h3>
        <p>Confira exemplos de equipamentos compatíveis com a proposta de locação apresentada pela empresa.</p>
        <p>O objetivo desta página é facilitar a leitura do catálogo e o pedido inicial de orçamento.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Catálogo"
        title="Equipamentos disponíveis"
        text="Itens apresentados de forma objetiva para apoiar consultas comerciais e pedidos de disponibilidade."
      />
      <div class="equipment-grid">
        {equipment.map((item) => <EquipmentCard {...item} />)}
      </div>
    </div>
  </section>

  <CTASection
    title="Quer confirmar disponibilidade ou prazo de entrega?"
    text="Nossa equipe pode orientar o atendimento inicial e registrar sua solicitação por WhatsApp."
    primaryHref="/contato"
    primaryLabel="Solicitar orçamento"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="Abrir WhatsApp"
  />
</BaseLayout>
