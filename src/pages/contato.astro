---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';

const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`;
---

<BaseLayout
  title="Contato | Solução Rental"
  description="Fale com a Solução Rental para solicitar orçamento de locação de equipamentos ou telas fachadeiras em Fortaleza."
  pathname="/contato"
>
  <PageHead title="Fale com nossa equipe" text="Solicite orçamento, confirme disponibilidade ou tire dúvidas sobre equipamentos e telas fachadeiras." />

  <section class="section">
    <div class="container contact-grid">
      <div>
        <h2>Envie sua solicitação</h2>
        <p>Ao enviar, o WhatsApp abre com a mensagem pronta. Todos os campos são obrigatórios.</p>
        <ContactForm />
      </div>
      <aside aria-labelledby="canais">
        <h2 id="canais">Canais diretos</h2>
        <dl class="facts facts--stacked">
          <div><dt>WhatsApp</dt><dd><a class="text-link" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">{site.whatsappLabel}</a></dd></div>
          <div><dt>Telefone</dt><dd><a class="text-link" href={`tel:+${site.whatsapp}`}>{site.phone}</a></dd></div>
          {site.email && <div><dt>E-mail</dt><dd><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></dd></div>}
          <div><dt>Endereço</dt><dd>{site.address}<br /><a class="text-link" href={mapHref} target="_blank" rel="noreferrer">Abrir no mapa</a></dd></div>
          <div><dt>Empresa</dt><dd>{site.legalName}<br />CNPJ {site.cnpj}<br />{site.branchType}, situação {site.status.toLowerCase()}</dd></div>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>
