---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contato | Solução Rental"
  description="Estamos prontos para atender sua solicitação. Peça um orçamento ou tire suas dúvidas."
  pathname="/contato"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-panel">
        <span class="eyebrow">Contato</span>
        <h1>Fale conosco</h1>
        <p>Estamos prontos para atender sua solicitação, pedir um orçamento ou esclarecer dúvidas sobre locação, telas e segurança.</p>
      </div>
      <div class="hero-highlight">
        <h3>Resposta mais rápida</h3>
        <p>Como não existe mais o antigo `enviar.php`, o formulário agora envia a mensagem diretamente para o WhatsApp com os dados preenchidos.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div>
        <SectionHeading
          eyebrow="Informações"
          title="Canais diretos de atendimento"
          text="Escolha o melhor canal para falar com a equipe."
        />

        <div class="contact-stack">
          <article class="contact-card">
            <div class="contact-icon"><Icon name="phone" /></div>
            <div>
              <h3>Telefones</h3>
              <p>{site.phone}</p>
              <p>{site.whatsappLabel}</p>
            </div>
          </article>

          <article class="contact-card">
            <div class="contact-icon"><Icon name="mail" /></div>
            <div>
              <h3>E-mail</h3>
              <p>{site.email}</p>
              <p>{site.salesEmail}</p>
            </div>
          </article>

          <article class="contact-card">
            <div class="contact-icon"><Icon name="pin" /></div>
            <div>
              <h3>Endereço</h3>
              <p>{site.address}</p>
            </div>
          </article>
        </div>
      </div>

      <div class="contact-stack">
        <article class="info-card">
          <h3>Envie uma mensagem</h3>
          <p>Preencha os campos abaixo e vamos abrir a conversa no WhatsApp com tudo organizado.</p>
          <ContactForm />
        </article>

        <article class="map-placeholder">
          <h3>Área de atendimento</h3>
          <p>Fortaleza e região metropolitana.</p>
          <p>O espaço foi mantido pronto para um embed de mapa real quando você quiser conectar o endereço definitivo.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
