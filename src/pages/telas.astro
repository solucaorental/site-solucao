---
import BaseLayout from '../layouts/BaseLayout.astro';
import Facade from '../components/Facade.astro';
import AreaCalculator from '../components/AreaCalculator.astro';
import CTASection from '../components/CTASection.astro';
import { diferenciais, site, telasBenefits, telasFeatures } from '../data/site';
---

<BaseLayout
  title="Telas Fachadeiras | Solução Rental"
  description="Telas fachadeiras para obras em Fortaleza e região com atendimento direto da Solução Rental."
  pathname="/telas"
>
  <section class="screen-hero">
    <div class="container screen-hero-inner">
      <div>
        <h1>Telas fachadeiras para obras</h1>
        <p class="lead">Fornecimento para proteção e organização de canteiros, com atendimento comercial direto em Fortaleza e região.</p>
        <div class="actions">
          <a class="btn btn-action" href="#medidas">Calcular área e pedir orçamento</a>
          <a class="btn btn-outline" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">Falar no WhatsApp</a>
        </div>
      </div>
      <Facade toggle />
    </div>
  </section>

  <section class="section" aria-labelledby="aplicacao">
    <div class="container split">
      <div class="split-intro">
        <h2 id="aplicacao">Como as telas ajudam na obra</h2>
        <p>São amplamente utilizadas para melhorar a organização visual e a segurança do entorno do canteiro.</p>
      </div>
      <ul class="check-list">{telasFeatures.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section section--blue" id="medidas" aria-labelledby="medidas-titulo">
    <div class="container measure">
      <div>
        <h2 id="medidas-titulo">Calcule a área de tela</h2>
        <p>Com duas medidas, o pedido já chega à equipe com a área estimada da sua obra.</p>
        <svg class="measure-figure" viewBox="0 0 320 190" role="img" aria-label="Fachada com as duas medidas indicadas: comprimento na base e altura na lateral">
          <path d="M60 20h240v130H60z" fill="#fff" fill-opacity=".14" stroke="#fff" />
          <path d="M120 20v130M180 20v130M240 20v130M60 52h240M60 85h240M60 118h240" stroke="#fff" stroke-opacity=".45" />
          <path d="M60 168h240M60 162v12M300 162v12M42 20v130M36 20h12M36 150h12" stroke="#f79a68" stroke-width="2.5" />
          <text x="180" y="187" fill="#fff" font-size="14" text-anchor="middle">Comprimento</text>
          <text x="28" y="85" fill="#fff" font-size="14" text-anchor="middle" transform="rotate(-90 28 85)">Altura</text>
        </svg>
      </div>
      <AreaCalculator />
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2>Como funciona o atendimento</h2>
        <p>Apresente sua necessidade, tire dúvidas e receba um atendimento personalizado da equipe.</p>
        <ul class="rule-list">{telasBenefits.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h2>Por que contar com a Solução Rental</h2>
        <dl class="reason-list">{diferenciais.map((item) => <div><dt>{item.title}</dt><dd>{item.description}</dd></div>)}</dl>
      </div>
    </div>
  </section>

  <CTASection
    title="Precisa de telas fachadeiras para sua obra?"
    text="Chame nossa equipe no WhatsApp para solicitar informações ou pedir um orçamento inicial."
    primaryHref="/contato?item=Telas%20fachadeiras"
    primaryLabel="Solicitar orçamento"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="Falar no WhatsApp"
  />
</BaseLayout>
