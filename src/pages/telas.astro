---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { diferenciais, site, telasBenefits, telasFeatures } from '../data/site';
---

<BaseLayout
  title="Telas Fachadeiras | Solução Rental"
  description="Telas fachadeiras para obras com atendimento em Fortaleza e regiao."
  pathname="/telas"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-panel">
        <span class="eyebrow">Telas fachadeiras</span>
        <h1>Telas fachadeiras para obras</h1>
        <p>Essa area do site apresenta o trabalho da Solucao Rental com telas fachadeiras para canteiros e fachadas de obra.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contato">Solicitar orçamento</a>
          <a class="btn btn-secondary" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">Falar no WhatsApp</a>
        </div>
      </div>
      <div class="hero-highlight">
        <h3>Servico real da empresa</h3>
        <p>Essa pagina foi ajustada para apresentar somente o atendimento real da empresa com telas fachadeiras.</p>
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container split-section">
      <div class="feature-card">
        <span class="eyebrow">Aplicacao</span>
        <h2>Uso de telas fachadeiras na obra</h2>
        <p>A Solucao Rental trabalha com telas fachadeiras como parte do atendimento voltado ao ambiente de construcao e organizacao do canteiro.</p>
        <ul class="feature-list">
          {telasFeatures.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="feature-card">
        <span class="eyebrow">Atendimento</span>
        <h2>Como a empresa atende essa demanda</h2>
        <p>O contato comercial acontece de forma direta, facilitando consulta, alinhamento da necessidade e pedido inicial de orcamento.</p>
        <ul class="feature-list">
          {telasBenefits.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Diferenciais"
        title="Por que falar com a Solucao Rental"
        text="Resumo de pontos que ajudam a apresentar esse servico com mais clareza no site."
      />
      <div class="feature-grid">
        {diferenciais.map((item) => (
          <article class="feature-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Precisa de telas fachadeiras para sua obra?"
    text="Chame no WhatsApp para tirar duvidas e pedir um orcamento inicial."
    primaryHref="/contato"
    primaryLabel="Falar com especialista"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="WhatsApp"
  />
</BaseLayout>
