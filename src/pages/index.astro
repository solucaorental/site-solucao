---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import EquipmentCard from '../components/EquipmentCard.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import CTASection from '../components/CTASection.astro';
import { companyHighlights, equipment, portfolioItems, services, site } from '../data/site';
---

<BaseLayout
  title="Solução Rental | Locação de equipamentos para construção em Fortaleza"
  description={site.description}
  pathname="/"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-panel">
        <span class="eyebrow">Locação e apoio para construção</span>
        <h1>{site.name}</h1>
        <p>{site.heroText}</p>
        <p class="hero-note">
          Empresa com CNPJ ativo desde 05/12/2012, sediada em Fortaleza/CE e com foco principal em locação de máquinas e equipamentos para construção.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">
            Falar no WhatsApp
          </a>
          <a class="btn btn-secondary" href="/contato">Solicitar orçamento</a>
        </div>
        <div class="hero-metrics">
          {companyHighlights.map((item) => (
            <div class="metric-card">
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="hero-side">
        <div class="hero-highlight">
          <h3>Atuação voltada ao setor da construção</h3>
          <p>Apresentacao institucional destacando locacao de equipamentos, telas fachadeiras e atendimento para obras.</p>
        </div>
        <div class="hero-stack">
          <div class="hero-tile">
            <strong>Locação de equipamentos</strong>
            <span>Atividade econômica principal da empresa para atendimento a obras e operações de campo.</span>
          </div>
          <div class="hero-tile">
            <strong>Telas fachadeiras</strong>
            <span>Atendimento para obras que precisam de telas fachadeiras com contato comercial rapido.</span>
          </div>
          <div class="hero-tile">
            <strong>Base em Fortaleza</strong>
            <span>Endereço no bairro Mondubim e contato direto por WhatsApp para atendimento inicial.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Serviços"
        title="Áreas de atuação da empresa"
        text="Resumo das frentes apresentadas no site, com destaque para locacao de equipamentos e telas fachadeiras."
      />
      <div class="card-grid services-grid">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container split-section">
      <div class="highlight-surface">
        <span class="eyebrow">Quem somos</span>
        <h2>Empresa ativa, matriz em Fortaleza e atuação na construção</h2>
        <p>
          A SOLUCAO RENTAL LTDA - ME foi fundada em 05/12/2012 e mantém situação cadastral ativa, com sede em Fortaleza, Ceará.
        </p>
        <p>
          Seu CNAE principal é o aluguel de máquinas e equipamentos para construção sem operador, com atividades secundárias ligadas a manutenção, obras civis e infraestrutura.
        </p>
        <a class="btn btn-primary" href="/quem-somos">Conheça a empresa</a>
      </div>

      <div class="stats-grid">
        {companyHighlights.map((item) => (
          <div class="stat-card">
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Locação"
        title="Equipamentos em destaque"
        text="Exemplos de equipamentos alinhados à proposta de locação para construção apresentada no site."
      />
      <div class="equipment-grid">
        {equipment.map((item) => <EquipmentCard {...item} />)}
      </div>
      <div class="hero-actions hero-actions--center">
        <a class="btn btn-primary" href="/locacao">Ver todos os equipamentos</a>
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <SectionHeading
        eyebrow="Serviços"
        title="Frentes de atendimento em destaque"
        text="Visão resumida das linhas de serviço e apoio operacional que fazem parte da apresentação institucional."
      />
      <div class="portfolio-grid">
        {portfolioItems.slice(0, 3).map((item) => <PortfolioCard {...item} />)}
      </div>
      <div class="hero-actions hero-actions--center">
        <a class="btn btn-primary" href="/portfolio">Ver portfólio completo</a>
      </div>
    </div>
  </section>

  <CTASection
    title="Precisa de locação de equipamentos ou informações sobre atendimento?"
    text="Fale com a empresa pelo WhatsApp e solicite um contato inicial para orçamento ou esclarecimentos."
    primaryHref="/contato"
    primaryLabel="Solicitar orçamento"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="Chamar no WhatsApp"
  />
</BaseLayout>
