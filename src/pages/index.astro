---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import EquipmentDrawing from '../components/EquipmentDrawing.astro';
import Icon from '../components/Icon.astro';
import { equipment, portfolioItems, services, site } from '../data/site';
---

<BaseLayout
  title="Solução Rental | Locação de equipamentos e telas fachadeiras em Fortaleza"
  description={site.description}
  pathname="/"
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>Equipamentos e telas fachadeiras para a sua obra</h1>
        <p class="lead">A {site.name} aluga máquinas e equipamentos para construção civil e fornece telas fachadeiras em Fortaleza e região desde 2012.</p>
        <div class="actions">
          <a class="btn btn-action" href="/contato">Solicitar orçamento</a>
          <a class="btn btn-inverse" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer"><Icon name="whatsapp" />Falar no WhatsApp</a>
        </div>
      </div>
    </div>
    <div class="hero-media">
      <img src="/images/andaime.webp" alt="Equipe montando andaime tubular em torno de uma construção de concreto" width="1290" height="768" fetchpriority="high" />
    </div>
  </section>

  <section class="section" aria-labelledby="servicos">
    <div class="container">
      <h2 id="servicos">Soluções para construção civil</h2>
      <div class="service-list">
        {services.map((service) => (
          <a class="service" href={service.href}>
            <Icon name={service.icon} />
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="equipamentos">
    <div class="container split">
      <div class="split-intro">
        <h2 id="equipamentos">Equipamentos para locação</h2>
        <p>Monte sua lista no catálogo e envie o pedido de orçamento com os itens já preenchidos.</p>
        <a class="btn btn-primary" href="/locacao">Ver catálogo completo</a>
      </div>
      <dl class="index-list index-list--equipment">
        {equipment.map((item) => (
          <div><dt><EquipmentDrawing title={item.title} />{item.title}</dt><dd>{item.description}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="empresa">
    <div class="container media-split">
      <img class="cut" src="/images/escoras.webp" alt="Profissional ajustando escora metálica sob uma laje" width="1190" height="768" loading="lazy" />
      <div>
        <h2 id="empresa">Experiência e presença local em Fortaleza</h2>
        <p>Com sede no bairro Mondubim, a empresa atende construtoras, prestadores de serviços e profissionais do setor com locação de máquinas e equipamentos sem operador.</p>
        <p><a class="text-link" href="/quem-somos">Conheça a empresa</a></p>
        <h3 class="sub">Frentes de atendimento</h3>
        <dl class="compact-list">
          {portfolioItems.slice(0, 3).map((item) => <div><dt>{item.title}</dt><dd>{item.subtitle}</dd></div>)}
        </dl>
        <p><a class="text-link" href="/portfolio">Ver todos os serviços</a></p>
      </div>
    </div>
  </section>

  <CTASection
    title="Precisa de equipamentos ou telas fachadeiras?"
    text="Fale com nossa equipe e solicite um orçamento sem compromisso."
    primaryHref="/contato"
    primaryLabel="Solicitar orçamento"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="Falar no WhatsApp"
  />
</BaseLayout>
