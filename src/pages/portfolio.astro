---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import CTASection from '../components/CTASection.astro';
import { portfolioItems, site } from '../data/site';
---

<BaseLayout
  title="Serviços | Solução Rental"
  description="Visão resumida das linhas de serviço e atuação da Solução Rental."
  pathname="/portfolio"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-panel">
        <span class="eyebrow">Serviços</span>
        <h1>Frentes de serviço apresentadas no site</h1>
        <p>Em vez de listar obras específicas sem base confirmada, esta seção apresenta as linhas de serviço associadas à empresa.</p>
      </div>
      <div class="highlight-surface">
        <h3>Apresentação institucional</h3>
        <p>A estrutura foi ajustada para comunicar locação, manutenção e apoio à construção com mais clareza.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Linhas de serviço"
        title="Onde a empresa atua"
        text="Resumo de serviços com base nas atividades informadas para a Solução Rental."
      />
      <div class="portfolio-grid">
        {portfolioItems.map((item) => <PortfolioCard {...item} />)}
      </div>
    </div>
  </section>

  <CTASection
    title="Precisa de atendimento para sua obra ou operação?"
    text="Converse com a empresa e alinhe o tipo de serviço ou locação que você precisa."
    primaryHref="/contato"
    primaryLabel="Solicitar proposta"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="Abrir WhatsApp"
  />
</BaseLayout>
