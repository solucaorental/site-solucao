---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import CTASection from '../components/CTASection.astro';
import { portfolioItems, site } from '../data/site';
---

<BaseLayout
  title="Portfólio | Solução Rental"
  description="Confira algumas das grandes obras que contaram com a parceria da Solução Rental."
  pathname="/portfolio"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-panel">
        <span class="eyebrow">Portfólio</span>
        <h1>Obras que contaram com nossa parceria</h1>
        <p>A página de portfólio foi reorganizada para valorizar prova social e deixar a experiência mais elegante e confiável.</p>
      </div>
      <div class="highlight-surface">
        <h3>Apresentação comercial mais forte</h3>
        <p>Mesmo sem fotos reais no acervo enviado, a estrutura foi preparada para receber imagens reais futuramente sem retrabalho.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Cases"
        title="Nosso portfólio"
        text="Confira algumas das grandes obras que contaram com a nossa parceria."
      />
      <div class="portfolio-grid">
        {portfolioItems.map((item) => <PortfolioCard {...item} />)}
      </div>
    </div>
  </section>

  <CTASection
    title="Quer uma solução parecida para a sua obra?"
    text="Converse com a equipe e receba uma proposta alinhada ao tipo de instalação ou locação que você precisa."
    primaryHref="/contato"
    primaryLabel="Solicitar proposta"
    secondaryHref={`https://wa.me/${site.whatsapp}`}
    secondaryLabel="Abrir WhatsApp"
  />
</BaseLayout>
